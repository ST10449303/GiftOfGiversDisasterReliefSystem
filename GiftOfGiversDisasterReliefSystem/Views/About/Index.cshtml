@{
    ViewData["Title"] = "About Us";
}

<!-- Page Header -->
<section class="page-header">
    <div class="container">

        <h1>About Us</h1>

        <p>
            Supporting communities through humanitarian relief and disaster response.
        </p>

    </div>
</section>


<!-- About Content -->
<section class="page-content">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-9">

                <div class="content-card">

                    <h2>Gift of the Givers</h2>

                    <p>
                        Gift of the Givers is a humanitarian organisation
                        focused on providing assistance to communities
                        affected by disasters and emergencies.
                    </p>

                    <p>
                        Our goal is to connect people who want to help
                        with communities that need support. Through
                        donations, volunteers and relief initiatives,
                        we aim to provide meaningful assistance during
                        difficult times.
                    </p>

                    <hr />

                    <h3>Our Focus</h3>

                    <div class="row mt-4">

                        <div class="col-md-4 mb-3">

                            <h5>Disaster Relief</h5>

                            <p>
                                Supporting communities during emergencies
                                and natural disasters.
                            </p>

                        </div>

                        <div class="col-md-4 mb-3">

                            <h5>Community Support</h5>

                            <p>
                                Helping vulnerable people access
                                essential assistance.
                            </p>

                        </div>

                        <div class="col-md-4 mb-3">

                            <h5>Volunteers</h5>

                            <p>
                                Giving individuals an opportunity to
                                contribute their time and skills.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>