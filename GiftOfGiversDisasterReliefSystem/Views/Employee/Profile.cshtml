@model GiftOfGiversDisasterReliefSystem.Data.ApplicationUser

@{
    ViewData["Title"] = "Manage Profile";
}

<div class="employee-page">

    <section class="employee-page-header">

        <div class="container">

            <p class="employee-small-title">
                ACCOUNT
            </p>

            <h1>
                Manage Profile
            </h1>

            <p>
                Keep your employee account information up to date.
            </p>

        </div>

    </section>


    <section class="employee-content">

        <div class="container">

            <div class="employee-profile-container">

                <div class="employee-panel-card">

                    <div class="employee-card-heading">

                        <h2>
                            Profile Information
                        </h2>

                        <p>
                            Update the information associated
                            with your employee account.
                        </p>

                    </div>


                    @if (ViewBag.SuccessMessage != null)
                    {
                        <div class="employee-success">
                            @ViewBag.SuccessMessage
                        </div>
                    }


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <form asp-controller="Employee"
                          asp-action="Profile"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Full Name -->

                        <div class="employee-form-group">

                            <label for="fullName">
                                Full Name
                            </label>

                            <input type="text"
                                   id="fullName"
                                   name="fullName"
                                   value="@Model.FullName"
                                   class="form-control"
                                   placeholder="Enter your full name"
                                   required />

                        </div>


                        <!-- Email -->

                        <div class="employee-form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input type="email"
                                   id="email"
                                   name="email"
                                   value="@Model.Email"
                                   class="form-control"
                                   placeholder="Enter your email address"
                                   required />

                        </div>


                        <!-- Account Type -->

                        <div class="employee-form-group">

                            <label>
                                Account Type
                            </label>

                            <div class="employee-account-type">

                                <span>
                                    Employee
                                </span>

                                <small>
                                    Your account role
                                </small>

                            </div>

                        </div>


                        <!-- Actions -->

                        <div class="employee-form-actions">

                            <button type="submit"
                                    class="employee-green-button">

                                Save Changes

                            </button>

                            <a asp-controller="Employee"
                               asp-action="Index"
                               class="employee-back-button">

                                Back to Dashboard

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </section>

</div>