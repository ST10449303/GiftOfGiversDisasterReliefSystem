@model IEnumerable<GiftOfGiversDisasterReliefSystem.Data.ContactMessage>

@{
    ViewData["Title"] = "Contact Messages";
}

<div class="employee-page">

    <!-- ==========================================
         PAGE HEADER
         ========================================== -->

    <section class="employee-dashboard-header">

        <div class="container">

            <p class="employee-small-title">
                EMPLOYEE DASHBOARD
            </p>

            <h1>
                Contact Messages
            </h1>

            <p>
                View enquiries and messages submitted by visitors.
            </p>

        </div>

    </section>


    <!-- ==========================================
         MESSAGES
         ========================================== -->

    <section class="employee-content">

        <div class="container">

            <div class="employee-section-heading">

                <h2>
                    Received Messages
                </h2>

                <p>
                    Messages submitted through the Contact Us page.
                </p>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="row g-4">

                    @foreach (var message in Model)
                    {
                        <div class="col-12">

                            <div class="employee-dashboard-card">

                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                                    <div>

                                        <h3>
                                            @message.Name
                                        </h3>

                                        <p class="mb-1">
                                            <strong>Email:</strong>
                                            @message.Email
                                        </p>

                                        <p class="mb-0">
                                            <strong>Date:</strong>
                                            @message.DateSent.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")
                                        </p>

                                    </div>


                                    <div>

                                        @if (message.IsRead)
                                        {
                                            <span class="badge bg-success">
                                                Read
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                New
                                            </span>
                                        }

                                    </div>

                                </div>


                                <hr />


                                <div class="mt-3">

                                    <h5>
                                        Message
                                    </h5>

                                    <p>
                                        @message.Message
                                    </p>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="content-card text-center">

                    <h3>
                        No Messages
                    </h3>

                    <p>
                        There are currently no contact messages from visitors.
                    </p>

                </div>
            }

        </div>

    </section>

</div>