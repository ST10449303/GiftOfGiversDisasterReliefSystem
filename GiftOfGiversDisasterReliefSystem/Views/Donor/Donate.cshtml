@{
    ViewData["Title"] = "Donate";
}

<div class="donor-dashboard">

    <!-- =========================================
         DONATION HEADER
         ========================================= -->

    <section class="donor-welcome">

        <div class="container">

            <p class="donor-small-title">
                DONATION
            </p>

            <h1>
                Make a Difference
            </h1>

            <p>
                Your donation helps provide essential support
                to people affected by disasters and emergencies.
            </p>

        </div>

    </section>


    <!-- =========================================
         DONATION FORM
         ========================================= -->

    <section class="donor-dashboard-content">

        <div class="container">

            <div class="donor-panel-card">

                <h2>
                    Make a Donation
                </h2>

                <p>
                    Choose how you would like to support
                    Gift of the Givers.
                </p>


                <!-- Validation Messages -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">

                        Please correct the errors below
                        and try again.

                    </div>
                }


                <form asp-controller="Donor"
                      asp-action="Donate"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- =================================
                         DONATION TYPE
                         ================================= -->

                    <div class="mb-3">

                        <label for="donationType"
                               class="form-label">

                            Donation Type

                        </label>

                        <select id="donationType"
                                name="donationType"
                                class="form-select"
                                required>

                            <option value="">
                                Select donation type
                            </option>

                            <option value="One-Time">
                                One-Time Donation
                            </option>

                            <option value="Recurring">
                                Recurring Donation
                            </option>

                        </select>

                        @Html.ValidationMessage(
                        "donationType",
                                                "",
                                                new { @class = "text-danger" })

                    </div>


                    <!-- =================================
                         CURRENCY
                         ================================= -->

                    <div class="mb-3">

                        <label for="currency"
                               class="form-label">

                            Currency

                        </label>

                        <select id="currency"
                                name="currency"
                                class="form-select"
                                required>

                            <option value="">
                                Select currency
                            </option>

                            <option value="ZAR">
                                ZAR - South African Rand
                            </option>

                            <option value="USD">
                                USD - US Dollar
                            </option>

                            <option value="EUR">
                                EUR - Euro
                            </option>

                        </select>

                        @Html.ValidationMessage(
                                                "currency",
                                                "",
                                                new { @class = "text-danger" })

                    </div>


                    <!-- =================================
                         DONATION AMOUNT
                         ================================= -->

                    <div class="mb-4">

                        <label for="amount"
                               class="form-label">

                            Donation Amount

                        </label>

                        <input type="number"
                               id="amount"
                               name="amount"
                               class="form-control"
                               placeholder="Enter amount"
                               min="1"
                               step="0.01"
                               required />

                        @Html.ValidationMessage(
                                                "amount",
                                                "",
                                                new { @class = "text-danger" })

                    </div>


                    <!-- =================================
                         DONATION INFORMATION
                         ================================= -->

                    <div class="alert alert-info">

                        <strong>Donation Information</strong>

                        <p class="mb-0 mt-2">

                            This is a prototype donation system.
                            No real payment will be processed.
                            A placeholder tax certificate will be
                            generated after the donation is recorded.

                        </p>

                    </div>


                    <!-- =================================
                         SUBMIT
                         ================================= -->

                    <button type="submit"
                            class="donor-yellow-button">

                        Continue Donation

                    </button>


                    <!-- BACK TO DASHBOARD -->

                    <a asp-controller="Donor"
                       asp-action="Index"
                       class="donor-outline-button ms-2">

                        Back to Dashboard

                    </a>

                </form>

            </div>

        </div>

    </section>

</div>